<Window x:Class="WPFThreads.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFThreads"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid  VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Content="Start" Grid.Column="1"  HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="1" VerticalAlignment="Center" Width="140" Height="50" Click="Button_Click" Grid.RowSpan="2"/>
        <Slider x:Name="producerDelaySlider" 
                HorizontalAlignment="Stretch" 
                Margin="10" Grid.Row="1" 
                VerticalAlignment="Bottom" 
                Width="140" Maximum="1000" 
                LargeChange="100" 
                SmallChange="10" 
                Value="500" 
                Cursor="Hand" 
                AutomationProperties.ItemType="int" 
                AutoToolTipPlacement="TopLeft"/>
        <Slider x:Name="consumerDelaySlider" 
                Grid.Column="2" 
                HorizontalAlignment="Stretch" 
                Margin="10" Grid.Row="1" 
                VerticalAlignment="Bottom" 
                Width="140" 
                Maximum="10000" 
                LargeChange="100" 
                SmallChange="10" 
                Value="5000" 
                Cursor="Hand"                 
                AutomationProperties.ItemType="int" 
                AutoToolTipPlacement="TopLeft"/>

        <RichTextBox Name="consumerOutput" Grid.Column="2" Grid.Row="0" Margin="10" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" Width="150">
            <FlowDocument>
                <Paragraph>
                    <Run Text=""/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
        <RichTextBox Name="producerOutput" Grid.Column="0" Grid.Row="0" Margin="10" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" Width="150">
            <FlowDocument>
                <Paragraph>
                    <Run Text=""/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
        <Label Content="Producer delay in ms" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <Label Content="Consumers delay in ms" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
        <Label Name ="collectionAmountLabel" Content="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="72"/>
    </Grid>
</Window>
